PORT=5000
# Use your MongoDB Atlas database user credentials locally.
# Do NOT commit the real URI or password to GitHub.
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@quiznova.zit3zgc.mongodb.net/quiznova?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173


# Optional: automatically create/promote the first QuizNova administrator.
# Keep these values private and add them to Vercel Production environment variables.
ADMIN_NAME=QuizNova Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
